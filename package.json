{
  "name": "allerion",
  "version": "2.0.0",
  "description": "Allerion, a Discord bot made for fun",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts",
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "deploy": "node --env-file-if-exists=.env src/deploy.ts",
    "typecheck": "tsc",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
