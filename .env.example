# From https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=
# Your app -> General Information -> Application ID
DISCORD_CLIENT_ID=
# Optional: register commands to this one server only (updates instantly while developing).
# Leave empty to register globally.
DEV_GUILD_ID=

# Optional: where the SQLite database lives (default: data/allerion.sqlite)
DATABASE_PATH=
